      "parameters": {
        "functionCode": "const cliente = $json.cliente || {};\nconst intent = $json.intent || 'OTRO';\nconst templates = $json.PLANTILLAS || {};\nconst firma = $json.SIGNATURE || '';\nlet msg = '';\nif (intent === 'QUIERO_PAGAR') {\n  msg = `Claro ${cliente.nombre || ''}. Tu monto es ${cliente.monto_mensual || ''} y vence el ${cliente.proximo_vencimiento || ''}. Link: ${cliente.link_pago || 'consúltanos por el link'}. ${firma}`;\n} else if (intent === 'YA_PAGUE') {\n  msg = `Gracias ${cliente.nombre || ''}. Envíanos tu comprobante y validamos el pago. ${firma}`;\n} else if (intent === 'HUMANO') {\n  msg = `Perfecto ${cliente.nombre || ''}. Ya avisamos al equipo para que te atienda. ${firma}`;\n} else {\n  msg = `Hola ${cliente.nombre || ''} 👋 ¿En qué podemos ayudarte? ${firma}`;\n}\nreturn [{ json: { respuesta: msg } }];"
      },
