    {
      "parameters": {
        "functionCode": "const clientes = items.map(i => i.json);\nconst hoy = new Date().toISOString().slice(0,10);\nconst vencenHoy = clientes.filter(c => c.proximo_vencimiento === hoy).map(c => `${c.nombre} (${c.whatsapp})`);\nconst seguimiento = clientes.filter(c => ['VENCIDO','MOROSO'].includes(c.estado_pago)).map(c => `${c.nombre} (${c.whatsapp})`);\nreturn [{ json: {\n  mensaje: `Reporte diario: Vencen hoy: ${vencenHoy.join('; ') || 'Ninguno'}. Seguimiento: ${seguimiento.join('; ') || 'Ninguno'}.`\n}}];"
      },
