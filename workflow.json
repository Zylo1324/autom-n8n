    {
      "parameters": {
        "functionCode": "const texto = $json.text || '';\nconst lower = texto.toLowerCase();\nlet intent = 'OTRO';\nif (lower.includes('pagar') || lower.includes('pago')) intent = 'QUIERO_PAGAR';\nif (lower.includes('ya pag')) intent = 'YA_PAGUE';\nif (lower.includes('soporte') || lower.includes('repar')) intent = 'SOPORTE';\nif (lower.includes('cambiar plan')) intent = 'CAMBIAR_PLAN';\nif (lower.includes('cancel')) intent = 'CANCELAR';\nif (lower.includes('humano')) intent = 'HUMANO';\nif (lower.includes('reset')) intent = 'RESET';\nreturn [{ json: { intent } }];"
      },
