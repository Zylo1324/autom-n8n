      "id": "clientes_validar_pago",
      "name": "Clientes: Leer (Validar pago)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        2180,
        820
      ]
    },
    {
      "parameters": {
        "functionCode": "const target = $json.cliente_id;\nconst cliente = items.map(i => i.json).find(c => c.cliente_id === target);\nif (!cliente) return [];\nconst today = new Date();\nconst next = new Date(today.getFullYear(), today.getMonth() + 1, cliente.dia_vencimiento || 1);\ncliente.fecha_ultimo_pago = today.toISOString().slice(0,10);\ncliente.proximo_vencimiento = next.toISOString().slice(0,10);\ncliente.estado_pago = 'AL_DIA';\ncliente.dias_mora = 0;\nreturn [{ json: cliente }];"
      },
      "id": "actualizar_estado_pago",
      "name": "Actualizar estado pago",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
