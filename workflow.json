        "jsCode": "const phoneDigits = $json.phoneDigits || '';\nconst rows = $items('Read Clientes').map((item) => item.json);\nconst normalized = (value) => String(value || '').replace(/\\D/g, '');\nconst cliente = rows.find((row) => normalized(row.whatsapp) === phoneDigits) || null;\nreturn [{\n  cliente,\n  phone: phoneDigits ? `+${phoneDigits}` : '',\n}];"
