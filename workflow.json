    {
      "parameters": {
        "jsCode": "const rows = $items('Read Clientes (Admin)').map((item) => item.json);\nconst clienteId = $json.clienteId;\nconst cliente = rows.find((row) => String(row.cliente_id) === String(clienteId));\nif (!cliente) {\n  return [{ error: 'Cliente no encontrado', clienteId }];\n}\nconst today = new Date().toISOString().slice(0, 10);\nconst nextDue = cliente.dia_vencimiento || '1';\nconst date = new Date();\nconst year = date.getUTCFullYear();\nconst month = date.getUTCMonth() + 1;\nconst nextDueDate = `${year}-${String(month).padStart(2, '0')}-${String(nextDue).padStart(2, '0')}`;\nreturn [{\n  cliente,\n  clienteId,\n  today,\n  nextDueDate,\n}];"
      },
