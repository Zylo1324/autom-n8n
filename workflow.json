        "functionCode": "const body = $json.body || $json;\nconst from = body.from || body.contacts?.[0]?.wa_id || body.sender || '';\nconst text = body.text?.body || body.message?.text || body.text || '';\nconst media = body.media || body.image || null;\nconst isOwner = from === $env.OWNER_WHATSAPP;\nconst normalized = from.replace(/[^0-9]/g, '');\nreturn [{\n  json: {\n    from_raw: from,\n    from: normalized ? `+${normalized}` : from,\n    text: text || '',\n    media,\n    isOwner\n  }\n}];"
      },
