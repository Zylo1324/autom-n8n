        -240
      ],
      "parameters": {
        "language": "javascript",
        "code": "const query = ($node['Admin: Parse comando'].json.query || '').trim();\nconst rows = $input.all().map(i => i.json);\nconst match = rows.find(row => String(row.cliente_id || '').toLowerCase() === query.toLowerCase());\nreturn [{ json: { cliente: match || null, query } }];"
      }
    },
