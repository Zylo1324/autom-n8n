        "jsonParameters": true,
        "headerParametersJson": "={{JSON.stringify({Authorization: 'Bearer ' + $env.WHATSAPP_TOKEN})}}",
        "bodyParametersJson": "={{JSON.stringify({ to: $node['Buscar cliente'].json.phone || $node['Normalizar número'].json.from, type: 'text', text: { body: $json.mensaje_final } })}}"
