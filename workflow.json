        820
      ]
    },
    {
      "parameters": {
        "functionCode": "const id = ($json.raw || '').split(' ').pop();\nreturn [{ json: { cliente_id: id } }];"
      },
      "id": "extraer_cliente_id",
      "name": "Extraer cliente_id",
      "type": "n8n-nodes-base.code",
