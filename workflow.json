      ]
    },
    {
      "parameters": {
        "functionCode": "const pago_id = `pago_${Date.now()}`;\nreturn [{ json: {\n  pago_id,\n  cliente_id: $json.cliente_id,\n  fecha_pago: $json.fecha_ultimo_pago,\n  monto: $json.monto_mensual || '',\n  metodo: 'MANUAL',\n  comprobante_url: '',\n  estado_validacion: 'VALIDADO',\n  observaciones: 'Validado por admin'\n}}];"
      },
