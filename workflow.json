    {
      "id": "40",
      "name": "Calcular reporte",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        970
      ],
      "parameters": {
        "language": "javascript",
        "code": "let alDia = 0;\nlet porVencer = 0;\nlet vencidos = 0;\nlet morosos = 0;\nlet montoEsperado = 0;\nconst today = new Date();\nfor (const item of $input.all()) {\n  const c = item.json;\n  const venc = c.proximo_vencimiento ? new Date(c.proximo_vencimiento) : null;\n  const diff = venc ? Math.floor((venc - new Date(today.toDateString())) / 86400000) : null;\n  const monto = Number(c.monto_mensual || 0);\n  montoEsperado += monto;\n  if (diff === null) continue;\n  if (diff >= 3) alDia += 1;\n  else if (diff >= 0) porVencer += 1;\n  else if (diff >= -7) vencidos += 1;\n  else morosos += 1;\n}\nreturn [{ json: { alDia, porVencer, vencidos, morosos, montoEsperado } }];"
      }
    },
    {
      "id": "41",
      "name": "Mensaje resumen",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        720,
        970
      ],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "mensaje_final",
              "value": "={{`Resumen: Al día ${$json.alDia}, Por vencer ${$json.porVencer}, Vencidos ${$json.vencidos}, Morosos ${$json.morosos}, Monto esperado ${$json.montoEsperado}`}}"
            }
          ]
        }
      }
    },
    {
      "id": "42",
      "name": "Enviar reporte",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        960,
        970
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.WHATSAPP_API_URL}}",
