    {
      "id": "15",
      "name": "Buscar cliente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        120
      ],
      "parameters": {
        "language": "javascript",
        "code": "const inputPhone = $node['Normalizar número'].json.from || '';\nconst normalize = (value) => `+${String(value || '').replace(/\\D/g, '')}`;\nconst rows = $input.all().map(i => i.json);\nconst match = rows.find(row => normalize(row.whatsapp || row.phone || '') === normalize(inputPhone));\nreturn [{ json: { phone: inputPhone, cliente: match || null } }];"
      }
    },
