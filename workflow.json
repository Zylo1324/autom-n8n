      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst fromRaw = body.from || body.From || body.sender || body.phone || '';\nconst text = body.text?.body || body.text || body.message || '';\nconst normalize = (value) => {\n  const digits = String(value || '').replace(/\\D/g, '');\n  return digits ? `+${digits}` : '';\n};\nconst from = normalize(fromRaw);\nconst owner = normalize($env.OWNER_WHATSAPP || '');\nreturn [{\n  from,\n  text: String(text || '').trim(),\n  isOwner: from && owner && from === owner,\n  phoneDigits: String(from || '').replace(/\\D/g, ''),\n}];"
      },
      "id": "c1d8d0d2-f6a3-4f8e-bfb2-7bd0c0f3a6e7",
