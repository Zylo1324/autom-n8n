    },
    {
      "id": "20",
      "name": "FAQ: Match",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        200
      ],
      "parameters": {
        "language": "javascript",
        "code": "const text = ($node['Normalizar número'].json.text || '').toLowerCase();\nconst rows = $input.all().map(i => i.json);\nlet faq = null;\nfor (const row of rows) {\n  const q = String(row.pregunta || row.question || '').toLowerCase();\n  if (q && text.includes(q)) {\n    faq = row;\n    break;\n  }\n}\nreturn [{ json: { ...$json, faq } }];"
      }
    },
