    {
      "id": "18",
      "name": "Detectar intención",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        200
      ],
      "parameters": {
        "language": "javascript",
        "code": "const text = ($node['Normalizar número'].json.text || '').toLowerCase();\nlet intent = 'OTRO';\nif (text.includes('pagar') || text.includes('pago')) intent = 'QUIERO_PAGAR';\nelse if (text.includes('ya pag')) intent = 'YA_PAGUE';\nelse if (text.includes('soporte') || text.includes('repar')) intent = 'SOPORTE';\nelse if (text.includes('cambiar plan')) intent = 'CAMBIAR_PLAN';\nelse if (text.includes('humano') || text.includes('asesor')) intent = 'HUMANO';\nreturn [{ json: { ...$json, intent } }];"
      }
    },
    {
      "id": "19",
      "name": "FAQ: Leer",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        1920,
        200
      ],
      "parameters": {
        "operation": "read",
