    {
      "parameters": {
        "functionCode": "const today = new Date();\nconst out = [];\nfor (const item of items) {\n  const c = item.json;\n  if (c.consentimiento_mensajes !== 'SI') continue;\n  const venc = c.proximo_vencimiento ? new Date(c.proximo_vencimiento) : null;\n  if (!venc) continue;\n  const diffDays = Math.ceil((venc - today) / (1000 * 60 * 60 * 24));\n  let tipo = null;\n  if (diffDays === 7) tipo = 'RECORDATORIO_7D';\n  if (diffDays === 2) tipo = 'RECORDATORIO_2D';\n  if (diffDays === 0) tipo = 'VENCE_HOY';\n  if (diffDays === -3) tipo = 'SEGUIMIENTO_3D';\n  if (diffDays === -7) tipo = 'SEGUIMIENTO_7D';\n  if (diffDays === -14) tipo = 'MOROSO_14D';\n  if (!tipo) continue;\n  out.push({ json: { cliente: c, tipo } });\n}\nreturn out;"
      },
      "id": "calcular_recordatorios",
      "name": "Calcular recordatorios",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
