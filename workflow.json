    {
      "parameters": {
        "mode": "rules",
        "rules": [
          {
            "operation": "regex",
            "value1": "={{$json.text}}",
            "value2": "^(RESUMEN HOY|RESUMEN SEMANAL|BUSCAR CLIENTE|VALIDAR PAGO|SUSPENDER|RESET MEMORIA)"
          }
        ]
      },
      "id": "comandos_admin",
      "name": "ADMIN: Comando?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1300,
        820
      ],
      "notes": "LOGS / ERRORES / ADMIN",
      "notesInFlow": true
    },
    {
      "parameters": {
        "functionCode": "const text = $json.text || '';\nlet action = 'OTRO';\nif (text.startsWith('RESUMEN HOY')) action = 'RESUMEN_HOY';\nif (text.startsWith('RESUMEN SEMANAL')) action = 'RESUMEN_SEMANAL';\nif (text.startsWith('BUSCAR CLIENTE')) action = 'BUSCAR_CLIENTE';\nif (text.startsWith('VALIDAR PAGO')) action = 'VALIDAR_PAGO';\nif (text.startsWith('SUSPENDER')) action = 'SUSPENDER';\nif (text.startsWith('RESET MEMORIA')) action = 'RESET_MEMORIA';\nreturn [{ json: { action, raw: text } }];"
      },
      "id": "admin_parser",
      "name": "ADMIN: Parse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        820
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.action}}",
              "operation": "equals",
              "value2": "VALIDAR_PAGO"
            }
          ]
        }
      },
      "id": "admin_validar_pago",
      "name": "ADMIN: Validar pago?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
