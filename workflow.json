    {
      "parameters": {
        "jsCode": "const text = ($json.text || '').toUpperCase();\nlet intent = 'OTRO';\nif (text.includes('QUIERO PAGAR')) intent = 'QUIERO_PAGAR';\nelse if (text.includes('YA PAGUE') || text.includes('YA PAGUÉ')) intent = 'YA_PAGUE';\nelse if (text.includes('SOPORTE')) intent = 'SOPORTE';\nelse if (text.includes('HUMANO') || text.includes('ASESOR')) intent = 'HUMANO';\nconst isOwner = $json.isOwner === true;\nconst isAdminCommand = isOwner && text.startsWith('VALIDAR PAGO');\nreturn [{\n  intent,\n  isOwner,\n  isAdminCommand,\n  adminText: text,\n  cliente: $json.cliente,\n  phone: $json.phone,\n  text: $json.text,\n}];"
      },
