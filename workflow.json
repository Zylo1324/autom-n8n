        "jsCode": "const faqRows = $items('Read FAQ').map((item) => item.json);\nconst text = String($json.text || '').toLowerCase();\nlet match = null;\nfor (const row of faqRows) {\n  const question = String(row.Pregunta || '').toLowerCase();\n  if (question && text.includes(question)) {\n    match = row;\n    break;\n  }\n}\nreturn [{\n  faqMatch: match,\n  cliente: $json.cliente,\n  phone: $json.phone,\n  text: $json.text,\n}];"
