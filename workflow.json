    {
      "parameters": {
        "functionCode": "const logs = $items('Mensajes Log: Leer');\nconst c = $json.cliente;\nconst tipo = $json.tipo;\nconst periodo = (c.proximo_vencimiento || '').slice(0, 7);\nconst key = `${c.cliente_id}_${tipo}_${periodo}`;\nconst exists = logs.some(l => (l.json.contenido_resumen || '').includes(key) && l.json.cliente_id === c.cliente_id);\nif (exists) return [];\nreturn [{ json: { cliente: c, tipo, message_key: key } }];"
      },
      "id": "idempotencia",
      "name": "Idempotencia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        980
      ]
    },
    {
      "parameters": {
        "functionCode": "const c = $json.cliente;\nconst tipo = $json.tipo;\nconst plantillas = $items('CONFIG')[0].json.PLANTILLAS || {};\nconst firma = $items('CONFIG')[0].json.SIGNATURE || '';\nconst nombre = c.nombre || 'cliente';\nconst monto = c.monto_mensual || '';\nconst fecha = c.proximo_vencimiento || '';\nconst link_pago = c.link_pago || 'consúltanos por el link';\nlet body = '';\nif (tipo === 'RECORDATORIO_7D') body = plantillas.recordatorio_7d;\nif (tipo === 'RECORDATORIO_2D') body = plantillas.recordatorio_2d;\nif (tipo === 'VENCE_HOY') body = plantillas.vence_hoy;\nif (tipo === 'SEGUIMIENTO_3D') body = plantillas.seguimiento_3d;\nif (tipo === 'SEGUIMIENTO_7D') body = plantillas.seguimiento_7d;\nif (tipo === 'MOROSO_14D') body = plantillas.suspension;\nbody = body.replace('{{nombre}}', nombre).replace('{{monto}}', monto).replace('{{fecha}}', fecha).replace('{{link_pago}}', link_pago).replace('{{firma}}', firma).replace('{{bot}}', $items('CONFIG')[0].json.BOT_NAME || 'Bot');\nbody = `${body}\n#${$json.message_key}`;\nreturn [{ json: { phone: c.whatsapp, mensaje: body, cliente_id: c.cliente_id, tipo_mensaje: tipo } }];"
      },
