      "parameters": {
        "language": "javascript",
        "code": "const cliente = $node['Buscar cliente'].json.cliente || {};\nconst resumen = String($json.mensaje_final || '').slice(0, 120);\nreturn [{ json: { timestamp: new Date().toISOString(), cliente_id: cliente.cliente_id || '', tipo_mensaje: $node['Detectar intención'].json.intent || 'OTRO', resumen } }];"
      }
    },
