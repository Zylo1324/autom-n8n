    {
      "id": "30",
      "name": "Calcular recordatorios",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        520
      ],
      "parameters": {
        "language": "javascript",
        "code": "const today = new Date();\nconst toDate = (value) => value ? new Date(value) : null;\nconst result = [];\nfor (const item of $input.all()) {\n  const c = item.json;\n  if (String(c.consentimiento_mensajes || '').toUpperCase() !== 'SI') continue;\n  const venc = toDate(c.proximo_vencimiento);\n  if (!venc) continue;\n  const diff = Math.floor((venc - new Date(today.toDateString())) / 86400000);\n  let tipo = null;\n  if (diff === 7) tipo = 'RECORDATORIO_7D';\n  else if (diff === 2) tipo = 'RECORDATORIO_2D';\n  else if (diff === 0) tipo = 'VENCE_HOY';\n  else if (diff === -3) tipo = 'SEGUIMIENTO_3D';\n  else if (diff === -7) tipo = 'SEGUIMIENTO_7D';\n  else if (diff === -14) tipo = 'MOROSO_14D';\n  if (!tipo) continue;\n  result.push({ json: { ...c, tipo_mensaje: tipo } });\n}\nreturn result;"
      }
    },
    {
      "id": "31",
      "name": "Recordatorios: Leer log",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        720,
        520
      ],
      "parameters": {
        "operation": "read",
        "sheetId": "={{$env.GOOGLE_SHEETS_ID}}",
        "range": "mensajes_log!A:H",
        "returnAll": true
      }
    },
    {
      "id": "32",
      "name": "Idempotencia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        520
      ],
      "parameters": {
        "language": "javascript",
        "code": "const logs = $input.all().map(i => i.json);\nconst pending = $node['Calcular recordatorios'].json ? [$node['Calcular recordatorios'].json] : $node['Calcular recordatorios'].data;\nconst safePending = Array.isArray(pending) ? pending : $items('Calcular recordatorios');\nconst result = [];\nfor (const item of safePending) {\n  const c = item.json || item;\n  const key = `${c.cliente_id || ''}_${c.tipo_mensaje || ''}_${c.proximo_vencimiento || ''}`;\n  const exists = logs.some(l => String(l.message_key || '') === key);\n  if (!exists) result.push({ json: { ...c, message_key: key } });\n}\nreturn result;"
      }
    },
    {
      "id": "33",
      "name": "Construir recordatorio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        520
      ],
      "parameters": {
        "language": "javascript",
        "code": "const c = $json;\nconst nombre = c.nombre || 'Hola';\nconst link = c.link_pago || '';\nconst mensajes = {\n  RECORDATORIO_7D: `Hola ${nombre}, tu pago vence en 7 días. Link: ${link}`,\n  RECORDATORIO_2D: `Hola ${nombre}, tu pago vence en 2 días. Link: ${link}`,\n  VENCE_HOY: `Hola ${nombre}, tu pago vence hoy. Link: ${link}`,\n  SEGUIMIENTO_3D: `Hola ${nombre}, tu pago venció hace 3 días. Link: ${link}`,\n  SEGUIMIENTO_7D: `Hola ${nombre}, tu pago venció hace 7 días. Link: ${link}`,\n  MOROSO_14D: `Hola ${nombre}, tu pago venció hace 14 días. Link: ${link}`\n};\nconst mensaje = mensajes[c.tipo_mensaje] || `Hola ${nombre}, recuerda tu pago.`;\nreturn [{ json: { ...c, mensaje_final: `${mensaje} #${c.message_key}` } }];"
      }
    },
    {
      "id": "34",
      "name": "Pausa 1s",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        520
      ],
      "parameters": {
        "language": "javascript",
        "code": "const wait = (ms) => new Promise(resolve => setTimeout(resolve, ms));\nawait wait(1000);\nreturn $input.all();"
      }
    },
    {
      "id": "35",
      "name": "Enviar recordatorio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1680,
        520
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.WHATSAPP_API_URL}}",
        "jsonParameters": true,
        "headerParametersJson": "={{JSON.stringify({Authorization: 'Bearer ' + $env.WHATSAPP_TOKEN})}}",
        "bodyParametersJson": "={{JSON.stringify({ to: $json.whatsapp || $json.phone || '', type: 'text', text: { body: $json.mensaje_final } })}}"
      }
    },
