      "parameters": {
        "jsCode": "const rows = $items('Read Clientes (Daily Alert)').map((item) => item.json);\nconst today = new Date().toISOString().slice(0, 10);\nconst vencenHoy = rows.filter((row) => row.proximo_vencimiento === today);\nconst morosos = rows.filter((row) => ['VENCIDO', 'MOROSO'].includes(String(row.estado_pago || '').toUpperCase()));\nconst message = `📌 Alertas del día\nVencen hoy: ${vencenHoy.length}\nMorosos/Vencidos: ${morosos.length}`;\nreturn [{ phone: $env.OWNER_WHATSAPP, message }];"
