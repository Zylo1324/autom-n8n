        "jsCode": "const rows = $items('Read Clientes (Weekly)').map((item) => item.json);\nconst summary = { AL_DIA: 0, POR_VENCER: 0, VENCIDO: 0, MOROSO: 0 };\nlet monto = 0;\nfor (const row of rows) {\n  const estado = row.estado_pago || 'AL_DIA';\n  if (summary[estado] !== undefined) summary[estado] += 1;\n  monto += Number(row.monto_mensual || 0);\n}\nconst message = `📊 Reporte semanal\nAL_DIA: ${summary.AL_DIA}\nPOR_VENCER: ${summary.POR_VENCER}\nVENCIDO: ${summary.VENCIDO}\nMOROSO: ${summary.MOROSO}\nMonto esperado: ${monto}`;\nreturn [{ phone: $env.OWNER_WHATSAPP, message }];"
      },
      "id": "711fe0f4-4b7f-4411-9d0f-f10b0d162b5a",
      "name": "Build Weekly Report",
      "type": "n8n-nodes-base.code",
