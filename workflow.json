    {
      "parameters": {
        "functionCode": "const clientes = items.map(i => i.json);\nconst alDia = clientes.filter(c => c.estado_pago === 'AL_DIA').length;\nconst porVencer = clientes.filter(c => c.estado_pago === 'POR_VENCER').length;\nconst vencidos = clientes.filter(c => c.estado_pago === 'VENCIDO').length;\nconst morosos = clientes.filter(c => c.estado_pago === 'MOROSO').length;\nconst montoEsperado = clientes.reduce((sum, c) => sum + (Number(c.monto_mensual) || 0), 0);\nreturn [{ json: {\n  resumen: { alDia, porVencer, vencidos, morosos, montoEsperado },\n  clientes\n}}];"
      },
