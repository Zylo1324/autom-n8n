    {
      "id": "2",
      "name": "Normalizar número",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "language": "javascript",
        "code": "const body = $json.body || $json;\nconst fromRaw = body.from || \"\";\nconst text = body.text || body.body?.text || body.message?.text || \"\";\nconst normalized = fromRaw ? `+${fromRaw.replace(/\\D/g, \"\")}` : \"\";\nconst owner = $env.OWNER_WHATSAPP || \"\";\nreturn [{ json: { from_raw: fromRaw, from: normalized, text, isOwner: normalized !== \"\" && normalized === owner } }];"
      }
    },
    {
      "id": "3",
      "name": "Validar origen",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.from}}",
              "operation": "notEmpty"
            }
          ]
        }
      }
    },
    {
      "id": "4",
      "name": "Responder invalido",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        720,
        -160
      ],
      "parameters": {
        "responseCode": 200,
        "responseData": "json",
        "responseBody": "={{ {status: 'ok'} }}"
      }
    },
