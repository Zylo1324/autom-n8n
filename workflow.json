    {
      "parameters": {
        "jsCode": "const rows = $items('Read Clientes (Reminders)').map((item) => item.json);\nconst today = new Date();\nconst fmt = (d) => d.toISOString().slice(0, 10);\nconst diffDays = (a, b) => Math.round((a - b) / (1000 * 60 * 60 * 24));\nconst templates = {\n  7: 'Recordatorio: tu pago vence en 7 días. Puedes pagar aquí: {{link}}',\n  2: 'Recordatorio: tu pago vence en 2 días. Link: {{link}}',\n  0: 'Tu pago vence hoy. Link: {{link}}',\n  -3: 'Tu pago está vencido hace 3 días. Link: {{link}}',\n  -7: 'Tu pago está vencido hace 7 días. Link: {{link}}',\n  -14: 'Tu pago está vencido hace 14 días. Link: {{link}}',\n};\nconst outputs = [];\nfor (const row of rows) {\n  if (String(row.consentimiento_mensajes || '').toUpperCase() !== 'SI') continue;\n  const due = row.proximo_vencimiento ? new Date(row.proximo_vencimiento) : null;\n  if (!due || Number.isNaN(due.getTime())) continue;\n  const delta = diffDays(due, today);\n  if (templates[delta] === undefined) continue;\n  const message = templates[delta].replace('{{link}}', row.link_pago || '');\n  outputs.push({\n    phone: row.whatsapp,\n    message: `${message}\n${$env.SIGNATURE || ''}`.trim(),\n    cliente_id: row.cliente_id || '',\n  });\n}\nreturn outputs;"
      },
