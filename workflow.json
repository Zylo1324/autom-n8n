    {
      "id": "23",
      "name": "Plantilla cliente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        280
      ],
      "parameters": {
        "language": "javascript",
        "code": "const c = $node['Buscar cliente'].json.cliente || {};\nconst nombre = c.nombre || 'Hola';\nconst monto = c.monto_mensual || c.monto || '';\nconst venc = c.proximo_vencimiento || '';\nconst link = c.link_pago || c.link || '';\nconst mensaje = `${nombre}, tu próximo vencimiento es ${venc}. Monto mensual: ${monto}. Puedes pagar aquí: ${link}`;\nreturn [{ json: { ...$json, mensaje_final: mensaje } }];"
      }
    },
