              "value1": "={{$json.isOwner}}",
              "operation": "isTrue"
            }
          ]
        }
      }
    },
    {
      "id": "6",
      "name": "Admin: Parse comando",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -160
      ],
      "parameters": {
        "language": "javascript",
        "code": "const text = ($json.text || '').trim();\nconst matchValidar = text.match(/^VALIDAR PAGO\\s+(\\S+)/i);\nconst matchBuscar = text.match(/^BUSCAR CLIENTE\\s+(.+)/i);\nlet action = 'NONE';\nlet query = '';\nif (matchValidar) {\n  action = 'VALIDAR_PAGO';\n  query = matchValidar[1];\n} else if (matchBuscar) {\n  action = 'BUSCAR_CLIENTE';\n  query = matchBuscar[1].trim();\n}\nreturn [{ json: { action, query, phone: $json.from, text } }];"
      }
    },
    {
      "id": "7",
      "name": "Admin: Es validar pago?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1200,
        -160
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.action}}",
              "operation": "equals",
              "value2": "VALIDAR_PAGO"
            }
          ]
        }
      }
    },
    {
      "id": "8",
